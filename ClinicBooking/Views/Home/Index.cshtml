         class="why-section">

    <div class="row align-items-center g-5">


        <!-- Left -->
        <div class="col-lg-6">

            <span class="section-kicker">
                WHY CLINICBOOK
            </span>

            <h2 class="why-title">

                Healthcare made
                <span>simple.</span>

            </h2>

            <p class="why-description">

                We make it easier to find the right doctor,
                choose a convenient appointment, and take
                the next step toward better healthcare.

            </p>


            <div class="why-features">


                <div class="why-feature">

                    <div class="why-feature-icon">

                        <i class="bi bi-search"></i>

                    </div>

                    <div>

                        <h5>
                            Find the right doctor
                        </h5>

                        <p>
                            Browse doctors and discover
                            specialists that match your needs.
                        </p>

                    </div>

                </div>


                <div class="why-feature">

                    <div class="why-feature-icon">

                        <i class="bi bi-calendar2-check"></i>

                    </div>

                    <div>

                        <h5>
                            Book with ease
                        </h5>

                        <p>
                            Schedule your appointment
                            quickly with a simple booking process.
                        </p>

                    </div>

                </div>


                <div class="why-feature">

                    <div class="why-feature-icon">

                        <i class="bi bi-shield-check"></i>

                    </div>

                    <div>

                        <h5>
                            Trusted healthcare
                        </h5>

                        <p>
                            Connect with qualified doctors
                            through one convenient platform.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- Right -->
        <div class="col-lg-6">

            <div class="why-visual">

                <div class="why-main-card">

                    <div class="why-main-icon">

                        <i class="bi bi-heart-pulse-fill"></i>

                    </div>

                    <span>
                        Your health matters
                    </span>

                    <strong>
                        Better care.
                        Better experience.
                    </strong>

                </div>


                <div class="why-mini-card mini-one">

                    <i class="bi bi-clock-history"></i>

                    <div>

                        <strong>
                            Fast
                        </strong>

                        <span>
                            Booking
                        </span>

                    </div>

                </div>


                <div class="why-mini-card mini-two">

                    <i class="bi bi-check-circle-fill"></i>

                    <div>

                        <strong>
                            Simple
                        </strong>

                        <span>
                            Experience
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CTA
========================= -->
<section id="contact"
         class="home-cta">

    <div class="row align-items-center g-4">

        <div class="col-lg-8">

            <span class="cta-kicker">
                START YOUR JOURNEY
            </span>

            <h2>
                Ready to book your appointment?
            </h2>

            <p>
                Find a trusted doctor and take the next
                step toward better healthcare today.
            </p>

        </div>


        <div class="col-lg-4 text-lg-end">

            <a asp-controller="Doctors"
               asp-action="Index"
               class="btn cta-button">

                Book Appointment

                <i class="bi bi-arrow-right ms-2"></i>

            </a>

        </div>

    </div>

</section>

