
@model List<ClinicBooking.Models.Doctor>

@{
    ViewData["Title"] = "Admin Doctors";
}

<section class="admin-doctors-page">

    <!-- =========================================
         PAGE HEADER
    ========================================== -->
    <div class="admin-page-header">

        <div>
            <span class="section-kicker">
                ADMINISTRATION
            </span>

            <h1>
                Doctors Management
            </h1>

            <p>
                Manage doctors, review their availability,
                and control appointment access.
            </p>
        </div>

        <a asp-controller="Doctors"
           asp-action="Create"
           class="btn clinic-btn-primary">

            <i class="bi bi-plus-lg me-2"></i>
            Add Doctor

        </a>

    </div>


    <!-- =========================================
         STAT CARDS
    ========================================== -->
    <div class="admin-stats-row">

        <div class="admin-stat-card">

            <div class="admin-stat-icon stat-blue">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <span>
                    Total Doctors
                </span>

                <strong>
                    @Model.Count
                </strong>
            </div>

        </div>


        <div class="admin-stat-card">

            <div class="admin-stat-icon stat-green">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div>
                <span>
                    Accepting Patients
                </span>

                <strong>
                    @Model.Count(d => d.IsAcceptingPatients)
                </strong>
            </div>

        </div>


        <div class="admin-stat-card">

            <div class="admin-stat-icon stat-red">
                <i class="bi bi-person-x-fill"></i>
            </div>

            <div>
                <span>
                    Unavailable
                </span>

                <strong>
                    @Model.Count(d => !d.IsAcceptingPatients)
                </strong>
            </div>

        </div>

    </div>


    <!-- =========================================
         MESSAGE
    ========================================== -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success admin-alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Message"]

        </div>
    }


    <!-- =========================================
         DOCTORS MANAGEMENT CARD
    ========================================== -->
    <div class="admin-table-card">

        <div class="admin-table-header">

            <div>

                <h2>
                    All Doctors
                </h2>

                <p>
                    Select doctors to update their availability.
                </p>

            </div>

            <span class="admin-table-count">
                @Model.Count records
            </span>

        </div>


        @if (Model.Count == 0)
        {
            <div class="admin-empty-state">

                <div class="empty-state-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <h3>
                    No doctors found
                </h3>

                <p>
                    Add your first doctor to start managing
                    the medical team.
                </p>

                <a asp-controller="Doctors"
                   asp-action="Create"
                   class="btn clinic-btn-primary">

                    <i class="bi bi-plus-lg me-2"></i>
                    Add Doctor

                </a>

            </div>
        }
        else
        {
            <form method="post">

                <div class="admin-table-wrapper">

                    <table class="table admin-doctors-table">

                        <thead>

                            <tr>

                                <th class="select-column">
                                    <input type="checkbox"
                                           id="selectAllDoctors"
                                           class="admin-checkbox" />
                                </th>

                                <th>
                                    Doctor
                                </th>

                                <th>
                                    Specialty
                                </th>

                                <th>
                                    Experience
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var doctor in Model)
                            {
                                <tr>

                                    <td class="select-column">

                                        <input type="checkbox"
                                               name="selectedDoctors"
                                               value="@doctor.Id"
                                               class="admin-checkbox doctor-checkbox" />

                                    </td>


                                    <!-- Doctor -->
                                    <td>

                                        <div class="admin-doctor-cell">

                                            <div class="admin-doctor-avatar">

                                                @if (!string.IsNullOrEmpty(doctor.PhotoName))
                                                {
                                                    <img src="/images/doctors/@doctor.PhotoName"
                                                         alt="@doctor.Name" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person"></i>
                                                }

                                            </div>

                                            <div>

                                                <strong>
                                                    @doctor.Name
                                                </strong>

                                                <span>
                                                    Doctor ID: @doctor.Id
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Specialty -->
                                    <td>

                                        <span class="admin-specialty">

                                            <i class="bi bi-heart-pulse-fill"></i>

                                            @doctor.Specialty

                                        </span>

                                    </td>


                                    <!-- Experience -->
                                    <td>

                                        <span class="admin-experience">

                                            <i class="bi bi-award"></i>

                                            @doctor.YearsOfExperience years

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (doctor.IsAcceptingPatients)
                                        {
                                            <span class="admin-status status-active">

                                                <span></span>

                                                Accepting Patients

                                            </span>
                                        }
                                        else
                                        {
                                            <div class="admin-status-actions">

                                                <span class="admin-status status-inactive">

                                                    <span></span>

                                                    Unavailable

                                                </span>

                                                <form asp-controller="Admin"
                                                      asp-action="MakeAvailable"
                                                      method="post"
                                                      class="make-available-form">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@doctor.Id" />

                                                    <button type="submit"
                                                            class="make-available-btn">

                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Make Available

                                                    </button>

                                                </form>

                                            </div>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================
                     BULK ACTION
                ================================== -->
                <div class="admin-bulk-actions">

                    <div class="bulk-selection-info">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Select one or more doctors to mark them
                            as unavailable.
                        </span>

                    </div>

                    <button type="submit"
                            class="btn admin-unavailable-btn">

                        <i class="bi bi-person-x me-2"></i>

                        Mark Selected Unavailable

                    </button>

                </div>

            </form>
        }

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const selectAll =
                document.getElementById("selectAllDoctors");

            const checkboxes =
                document.querySelectorAll(".doctor-checkbox");

            if (!selectAll) {
                return;
            }

            selectAll.addEventListener("change", function () {

                checkboxes.forEach(function (checkbox) {

                    checkbox.checked = selectAll.checked;

                });

            });

        });

    </script>

}

