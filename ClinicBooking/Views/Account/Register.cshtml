
@model ClinicBooking.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="account-page">

    <div class="account-card account-register-card">

        <!-- =========================================
             ACCOUNT HEADER
        ========================================== -->
        <div class="account-header">

            <div class="account-brand-icon">
                <i class="bi bi-plus-lg"></i>
            </div>

            <span class="account-kicker">
                JOIN CLINICBOOK
            </span>

            <h1>
                Create your account
            </h1>

            <p>
                Create an account to book appointments
                and manage your healthcare journey.
            </p>

        </div>


        <!-- =========================================
             FORM
        ========================================== -->
        <form method="post"
              class="account-form">

            <div asp-validation-summary="All"
                 class="account-validation-summary">
            </div>


            <!-- Email -->
            <div class="account-field">

                <label asp-for="Email"
                       class="account-label">
                    Email Address
                </label>

                <div class="account-input-wrapper">

                    <i class="bi bi-envelope"></i>

                    <input asp-for="Email"
                           class="form-control account-input"
                           type="email"
                           placeholder="Enter your email address"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="Email"
                      class="account-validation">
                </span>

            </div>


            <!-- Password -->
            <div class="account-field">

                <label asp-for="Password"
                       class="account-label">
                    Password
                </label>

                <div class="account-input-wrapper">

                    <i class="bi bi-lock"></i>

                    <input asp-for="Password"
                           id="registerPassword"
                           class="form-control account-input account-password-input"
                           type="password"
                           placeholder="Create a password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('registerPassword', this)"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="Password"
                      class="account-validation">
                </span>

            </div>


            <!-- Confirm Password -->
            <div class="account-field">

                <label asp-for="ConfirmPassword"
                       class="account-label">
                    Confirm Password
                </label>

                <div class="account-input-wrapper">

                    <i class="bi bi-shield-lock"></i>

                    <input asp-for="ConfirmPassword"
                           id="confirmPassword"
                           class="form-control account-input account-password-input"
                           type="password"
                           placeholder="Confirm your password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirmPassword', this)"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="account-validation">
                </span>

            </div>


            <!-- Submit -->
            <button type="submit"
                    class="account-submit-btn">

                <i class="bi bi-person-plus me-2"></i>

                Create Account

            </button>


            <!-- Login Link -->
            <div class="account-switch">

                <span>
                    Already have an account?
                </span>

                <a asp-controller="Account"
                   asp-action="Login">
                    Sign in
                </a>

            </div>

        </form>

    </div>

</section>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

                button.setAttribute("aria-label", "Hide password");

            } else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");

                button.setAttribute("aria-label", "Show password");

            }

        }

    </script>
}
